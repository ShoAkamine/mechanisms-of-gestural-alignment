        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1008" ANNOTATION_REF="a540">
                <ANNOTATION_VALUE>Might be framing her face to metaphorically refer to the entirety of the fribble as a face</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1057" ANNOTATION_REF="a566">
                <ANNOTATION_VALUE>She gestures an angle whilst referring to all subparts as being angular</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1245" ANNOTATION_REF="a768">
                <ANNOTATION_VALUE>typing is a reference to "laptop table" I think</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1345" ANNOTATION_REF="a891">
                <ANNOTATION_VALUE>aborted?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
