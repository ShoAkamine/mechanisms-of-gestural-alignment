        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1966" ANNOTATION_REF="a1633">
                <ANNOTATION_VALUE>Stll post-stroke hold after the super imposed beat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1967" ANNOTATION_REF="a1670">
                <ANNOTATION_VALUE>She seems to be depicting an "uitsteeksel" in general</ANNOTATION_VALUE>
            </REF_ANNOTATION>
