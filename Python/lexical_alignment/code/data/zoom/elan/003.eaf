    <TIER LINGUISTIC_TYPE_REF="imported-sep" PARTICIPANT="01" TIER_ID="A_speech">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2435"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>Oh kijk, ik heb een vierkant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2436"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Dus ik eh moet denk ik aan jou uit gaan leggen welke het is.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2437"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Ehm het is zeg maar de beker met het gekke ovale langwerpige onderstel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2438"
                TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Ã©Ã©n pluim en een half rondje aan de bovenkant en dan zo'n gek uitsteeksel aan de linkerkant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2439"
                TIME_SLOT_REF1="ts64" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>Ehm dat het een soort eh langwerpige rechthoek is met afgeronde hoeken.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2440"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts94">
                <ANNOTATION_VALUE>Die een beetje als een soort ovaal overkomen</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2441"
                TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>aan de onderkant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2442"
                TIME_SLOT_REF1="ts102" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>Op een soor- hij staat op een soort basis.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2443"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts116">
                <ANNOTATION_VALUE>Dat is de enige die op zo'n soort basis staat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2444"
                TIME_SLOT_REF1="ts122" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Ja,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2445"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>en dan met die,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2446"
                TIME_SLOT_REF1="ts134" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>ja met die ene pluim en dat ene half rondje.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2447"
                TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts154">
                <ANNOTATION_VALUE>Ja, hij is niet die (op) die op het vierkant staat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2448"
                TIME_SLOT_REF1="ts164" TIME_SLOT_REF2="ts166">
                <ANNOTATION_VALUE>Hij staat op een ehm</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2449"
                TIME_SLOT_REF1="ts168" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>ja wat is het?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2450"
                TIME_SLOT_REF1="ts172" TIME_SLOT_REF2="ts182">
                <ANNOTATION_VALUE>(N)et een soort ehm</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2451"
                TIME_SLOT_REF1="ts186" TIME_SLOT_REF2="ts192">
                <ANNOTATION_VALUE>#laughs# een beetje ja.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2452"
                TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts212">
                <ANNOTATION_VALUE>En zeg maar, ja, aan de zijkant zit Ã©Ã©n ehm uitsteeksel aan de linkerkant zeg maar.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2453"
                TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts226">
                <ANNOTATION_VALUE>Die een soort van recht is</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2454"
                TIME_SLOT_REF1="ts228" TIME_SLOT_REF2="ts234">
                <ANNOTATION_VALUE>en aan de bovenkant zit aan de rechterkant een zo'n pluim.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2455"
                TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts246">
                <ANNOTATION_VALUE>En aan de linkerkant van de bovenkant zo'n halve cirkel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2456"
                TIME_SLOT_REF1="ts250" TIME_SLOT_REF2="ts260">
                <ANNOTATION_VALUE>En hij staat op iets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2457"
                TIME_SLOT_REF1="ts264" TIME_SLOT_REF2="ts268">
                <ANNOTATION_VALUE>Ja, dat is hem.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2458"
                TIME_SLOT_REF1="ts274" TIME_SLOT_REF2="ts286">
                <ANNOTATION_VALUE>Ja, jij moet volgens mij drukken op de knop.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2459"
                TIME_SLOT_REF1="ts294" TIME_SLOT_REF2="ts296">
                <ANNOTATION_VALUE>Ja,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2460"
                TIME_SLOT_REF1="ts304" TIME_SLOT_REF2="ts306">
                <ANNOTATION_VALUE>top.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2461"
                TIME_SLOT_REF1="ts310" TIME_SLOT_REF2="ts312">
                <ANNOTATION_VALUE>#laughs# een beetje ja.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2462"
                TIME_SLOT_REF1="ts316" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>Oh, (met) die neuspiercing,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2463"
                TIME_SLOT_REF1="ts320" TIME_SLOT_REF2="ts326">
                <ANNOTATION_VALUE>met dat gekke dingetje eraan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2464"
                TIME_SLOT_REF1="ts328" TIME_SLOT_REF2="ts336">
                <ANNOTATION_VALUE>en die ene pluim bovenop.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2465"
                TIME_SLOT_REF1="ts342" TIME_SLOT_REF2="ts344">
                <ANNOTATION_VALUE>Dat is *K*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2466"
                TIME_SLOT_REF1="ts354" TIME_SLOT_REF2="ts356">
                <ANNOTATION_VALUE>OkÃ©, nu heb ik er (weer) Ã©Ã©n.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
