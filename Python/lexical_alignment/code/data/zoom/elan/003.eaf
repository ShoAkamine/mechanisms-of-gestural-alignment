        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1969" ANNOTATION_REF="a1703">
                <ANNOTATION_VALUE>seems to use direction to contrast with direction of gesture at 5:54</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
