        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a427" ANNOTATION_REF="a411">
                <ANNOTATION_VALUE>Are we willing to accept this handshape as representative of a square? If yes, it's iconic 01B...</ANNOTATION_VALUE>
