    <TIER LINGUISTIC_TYPE_REF="sym_ass" PARENT_REF="B_RH_gesture"
        PARTICIPANT="08.6" TIER_ID="B_RH_gesture_comments">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>Using 02A to guide matcher to 04A "the top is cut off"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a30">
