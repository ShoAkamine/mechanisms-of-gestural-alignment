            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>Lovely and neat gesture, but not specifically referring to particular subpart - also potentially no speech</ANNOTATION_VALUE>
