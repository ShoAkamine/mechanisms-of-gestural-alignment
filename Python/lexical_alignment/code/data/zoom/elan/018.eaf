                <ANNOTATION_VALUE>letting go of the hold/retracting rather than gesture?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a641" ANNOTATION_REF="a638">
                <ANNOTATION_VALUE>beats on top of hold</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a762" ANNOTATION_REF="a761">
                <ANNOTATION_VALUE>mostly RH though?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a789" ANNOTATION_REF="a772">
                <ANNOTATION_VALUE>speech: "the other one"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a790" ANNOTATION_REF="a776">
                <ANNOTATION_VALUE>Not very clear to me which arm represents which subpart</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a929" ANNOTATION_REF="a926">
                <ANNOTATION_VALUE>possible argument for this being 2-handed as RH depicts 'thorn' being pushed into LH ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a950" ANNOTATION_REF="a949">
                <ANNOTATION_VALUE>possible argument for this being 2-handed as RH depicts 'needle' being pushed into LH ...</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1047" ANNOTATION_REF="a1041">
                <ANNOTATION_VALUE>LH seems slightly shorter to me, which is why I went with 14B</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1048" ANNOTATION_REF="a1042">
                <ANNOTATION_VALUE>speech suggests gesture depicting fribble "hanging on" 14C</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1159" ANNOTATION_REF="a1156">
                <ANNOTATION_VALUE>I think LH is 08C, but may as well be 08D</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1208" ANNOTATION_REF="a1205">
                <ANNOTATION_VALUE>Getting Michael Jackson's Thriller vibes from this</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1370" ANNOTATION_REF="a1361">
                <ANNOTATION_VALUE>08A-rep</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1371" ANNOTATION_REF="a1362">
                <ANNOTATION_VALUE>08A-REP</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1516" ANNOTATION_REF="a1514">
                <ANNOTATION_VALUE>Unclear what subpart she's referring to</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1557" ANNOTATION_REF="a1556">
                <ANNOTATION_VALUE>negation marker, gesture type??</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
