        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3800"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>Oké, nu heb ik hem.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3801"
                TIME_SLOT_REF1="ts222" TIME_SLOT_REF2="ts230">
                <ANNOTATION_VALUE>Eh zal ik uitleggen wat ik zie?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3802"
                TIME_SLOT_REF1="ts236" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Ik zie eh links, dus het lijkt voor mij een beetje op een straaljager achter iets, want ik zie links twee van die uitsteeksels.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3803"
                TIME_SLOT_REF1="ts272" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Dus je had die die normale bak en dan heb ik links twee uitsteeksels.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3804"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>Bovenop heb ik een soort van paddenstoeletje dus een...</ANNOTATION_VALUE>
