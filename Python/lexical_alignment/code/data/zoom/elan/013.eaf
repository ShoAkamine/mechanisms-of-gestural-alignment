                TIME_SLOT_REF1="ts302" TIME_SLOT_REF2="ts309">
                <ANNOTATION_VALUE>Ja, eigenlijk een rond iets wat omhoog gaat met daarop...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
