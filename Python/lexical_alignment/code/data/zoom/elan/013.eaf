    <TIER LINGUISTIC_TYPE_REF="imported-sep" PARTICIPANT="01" TIER_ID="A_speech">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3782"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>Zie je een?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3783"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Oh, sorry s-.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3784"
                TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>Oké, het vierkant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3785"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Is goed.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3786"
                TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>Zou je kunnen omschrijven wat je ziet?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3787"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>Oh...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3788"
                TIME_SLOT_REF1="ts90" TIME_SLOT_REF2="ts93">
                <ANNOTATION_VALUE>Wacht misschien...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3789"
                TIME_SLOT_REF1="ts96" TIME_SLOT_REF2="ts98">
                <ANNOTATION_VALUE>Weet ik...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3790"
                TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts110">
                <ANNOTATION_VALUE>Want zeg maar, het is dan die eh, de bak inderdaad.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3791"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>En dan heb je links daarvan een uitsteeksel.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3792"
                TIME_SLOT_REF1="ts120" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>En daaraan nog een uitsteeksel omhoog met een vierkant erop.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3793"
                TIME_SLOT_REF1="ts136" TIME_SLOT_REF2="ts146">
                <ANNOTATION_VALUE>En dan rechts is het een soort van dienblad achtig iets.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3794"
                TIME_SLOT_REF1="ts155" TIME_SLOT_REF2="ts158">
                <ANNOTATION_VALUE>Oké.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3795"
                TIME_SLOT_REF1="ts166" TIME_SLOT_REF2="ts170">
                <ANNOTATION_VALUE>Ja, oké.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3796"
                TIME_SLOT_REF1="ts174" TIME_SLOT_REF2="ts178">
                <ANNOTATION_VALUE>Oké.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3797"
                TIME_SLOT_REF1="ts180" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>Dan moet ik toch de letter op ah- hardop zeggen?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3798"
