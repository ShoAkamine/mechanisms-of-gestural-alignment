    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="sym_ass"
        PARENT_REF="B_RH_gesture" PARTICIPANT="08.6" TIER_ID="B_RH_gesture_comments">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1387" ANNOTATION_REF="a551">
                <ANNOTATION_VALUE>She describes part 05A as being a bit like the one we did first, with the foot. She seems te depict the elongated shape of both fibble subparts.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1388" ANNOTATION_REF="a553">
                <ANNOTATION_VALUE>She might be trying to depict roundness, but the motion seems too straight to annotate it as such</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a979" ANNOTATION_REF="a586">
                <ANNOTATION_VALUE>noy sure about this one</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1389" ANNOTATION_REF="a610">
                <ANNOTATION_VALUE>She says "the round nose without the piercing"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1268" ANNOTATION_REF="a651">
                <ANNOTATION_VALUE>bit stumped by this one, she says horizantal during this gesture</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
