    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="sym_ass"
        PARENT_REF="A_LH_gesture" PARTICIPANT="05.6" TIER_ID="A_LH_gesture_comments">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1444" ANNOTATION_REF="a937">
                <ANNOTATION_VALUE>The gesture seems to depict floating</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1445" ANNOTATION_REF="a938">
                <ANNOTATION_VALUE>unsure about this one</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1446" ANNOTATION_REF="a946">
                <ANNOTATION_VALUE>Unsure which hand refers to which subpart exactly</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1768" ANNOTATION_REF="a1036">
                <ANNOTATION_VALUE>unsure</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2058" ANNOTATION_REF="a1051">
                <ANNOTATION_VALUE>unsure, I feel the gesture should be iconic, but it does not resemble the "mushroom" she talks about</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2425" ANNOTATION_REF="a1074">
                <ANNOTATION_VALUE>Metaphorical upturning of icecream cone</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2059" ANNOTATION_REF="a1075">
                <ANNOTATION_VALUE>The shape of the gesure does not match the fribble part, but may be metaphorical "pinochio nose" </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2426" ANNOTATION_REF="a1283">
                <ANNOTATION_VALUE>The gesture is probably metaphorical, relating to "standing", so i took the 13D to be the referent</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2427" ANNOTATION_REF="a1306">
                <ANNOTATION_VALUE>metaphorical, based on floating, so I chose the referent to be 07B as the surface the fribbel "floats" on</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2428" ANNOTATION_REF="a1367">
                <ANNOTATION_VALUE>unsure</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
