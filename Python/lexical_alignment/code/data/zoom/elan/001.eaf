        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2934" ANNOTATION_REF="a1002">
                <ANNOTATION_VALUE>Metaphorical representation, holding the handle of a ladle</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2935" ANNOTATION_REF="a1227">
                <ANNOTATION_VALUE>movement seems to be torso movement, rather than manual</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2936" ANNOTATION_REF="a1241">
                <ANNOTATION_VALUE>She specifically refers to the square top of the fribble subpart</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2937" ANNOTATION_REF="a1346">
                <ANNOTATION_VALUE>Appears to be a reduced form of the upturned icecream cone mimic</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
