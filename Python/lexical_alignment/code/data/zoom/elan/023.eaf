        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2909"
                TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts470">
                <ANNOTATION_VALUE>En dan heb je aan de rechterkant en aan de linkerkant drie van die driehoekjes lijkt het net.</ANNOTATION_VALUE>
