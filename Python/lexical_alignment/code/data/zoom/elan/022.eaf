    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="sym_ass"
        PARENT_REF="B_LH_gesture" PARTICIPANT="07.6" TIER_ID="B_LH_gesture_comments">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1908" ANNOTATION_REF="a490">
                <ANNOTATION_VALUE>unsure</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1937" ANNOTATION_REF="a497">
                <ANNOTATION_VALUE>she is gesturing the concept of gesturing, I believe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1945" ANNOTATION_REF="a503">
                <ANNOTATION_VALUE>aborted</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1959" ANNOTATION_REF="a525">
                <ANNOTATION_VALUE>mimicking "leg gesture"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2017" ANNOTATION_REF="a621">
                <ANNOTATION_VALUE>She is mimicking participant A's gesture</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2086" ANNOTATION_REF="a727">
                <ANNOTATION_VALUE>kind of looks like a gesture, but I don't know what it would be supposed to mean</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2131" ANNOTATION_REF="a765">
                <ANNOTATION_VALUE>They are discussing an earlier Fribble, I presume the gesture refers to this one</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2248" ANNOTATION_REF="a1027">
                <ANNOTATION_VALUE>there is a leg gesture</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
