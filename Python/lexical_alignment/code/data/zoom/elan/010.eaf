        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1347"
                TIME_SLOT_REF1="ts6" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>Oké, ik heb een rood vierkant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
