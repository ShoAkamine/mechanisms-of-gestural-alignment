        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1348"
                TIME_SLOT_REF1="ts14" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>Ehm even kijken, links heb je eigenlijk een heel groot uitsteeksel.</ANNOTATION_VALUE>
