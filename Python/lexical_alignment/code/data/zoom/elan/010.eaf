        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1349"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Dus een uitsteeksel met daarop een heel groot uitsteeksel omhoog.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1350"
                TIME_SLOT_REF1="ts34" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>En aan de rechterkant heb je een soort tafeltje eigenlijk, een rond tafeltje.</ANNOTATION_VALUE>
