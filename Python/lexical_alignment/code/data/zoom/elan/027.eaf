        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1193"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts27">
                <ANNOTATION_VALUE>It looks like two (de)same objects going left in a sort of cup-like shape.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1194"
                TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>Do you see anything similar to that?</ANNOTATION_VALUE>
