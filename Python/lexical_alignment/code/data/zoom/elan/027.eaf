            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1774"
                TIME_SLOT_REF1="ts223" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>O is it some kind of triangle sticking out?</ANNOTATION_VALUE>
