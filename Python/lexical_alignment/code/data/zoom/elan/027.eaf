        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2037"
                TIME_SLOT_REF1="ts3299" TIME_SLOT_REF2="ts3301">
                <ANNOTATION_VALUE>and the bar on top.</ANNOTATION_VALUE>
