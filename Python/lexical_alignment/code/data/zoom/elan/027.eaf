        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2028"
                TIME_SLOT_REF1="ts3167" TIME_SLOT_REF2="ts3169">
                <ANNOTATION_VALUE>and then a small arm on the left.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2029"
                TIME_SLOT_REF1="ts3193" TIME_SLOT_REF2="ts3195">
                <ANNOTATION_VALUE>That's number *10*</ANNOTATION_VALUE>
