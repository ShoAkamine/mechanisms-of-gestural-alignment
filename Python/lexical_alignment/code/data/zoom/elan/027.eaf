        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1196"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts47">
                <ANNOTATION_VALUE>Yes, so two identical objects</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1197"
                TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts53">
                <ANNOTATION_VALUE>and it it's kind of like a kind of dagger inserted into an in the bag, so to speak.</ANNOTATION_VALUE>
