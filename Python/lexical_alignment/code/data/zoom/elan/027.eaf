            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2027"
                TIME_SLOT_REF1="ts3163" TIME_SLOT_REF2="ts3165">
                <ANNOTATION_VALUE>and then left and right another kind of pixel</ANNOTATION_VALUE>
