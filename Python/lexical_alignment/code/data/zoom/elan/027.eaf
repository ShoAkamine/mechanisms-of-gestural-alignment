            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2026"
                TIME_SLOT_REF1="ts3159" TIME_SLOT_REF2="ts3161">
                <ANNOTATION_VALUE>the inverted cone on top and (one) identical one in front</ANNOTATION_VALUE>
