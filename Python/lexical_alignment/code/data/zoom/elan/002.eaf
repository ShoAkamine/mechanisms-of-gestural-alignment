        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1474" ANNOTATION_REF="a1301">
                <ANNOTATION_VALUE>She gestures about gesture</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1475" ANNOTATION_REF="a1306">
                <ANNOTATION_VALUE>metaphorical "ear" of the mug</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1476" ANNOTATION_REF="a1309">
                <ANNOTATION_VALUE>metaphorical slicing of a lemon</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1477" ANNOTATION_REF="a1310">
                <ANNOTATION_VALUE>metaphorical: ptutting a slice of lemon on a cup</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1478" ANNOTATION_REF="a1316">
                <ANNOTATION_VALUE>She gestures 2, for 2 appendages</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1479" ANNOTATION_REF="a1324">
                <ANNOTATION_VALUE>non-manual gesture</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1480" ANNOTATION_REF="a1401">
                <ANNOTATION_VALUE>unclear, but she seems to extend two fingers for 2 appendages</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
